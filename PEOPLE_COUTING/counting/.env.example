# ==============================================================================
# CẤU HÌNH CMS BACKEND (BẮT BUỘC - Thiết lập theo máy chủ CMS thực tế)
# ==============================================================================
# Địa chỉ URL của CMS Backend API
# Hỗ trợ cực kỳ linh hoạt các định dạng:
#   - IP hoặc Domain: http://192.168.1.100:8080 hoặc https://cms.mydomain.vn
#   - Không cần gõ http:// nếu dùng cổng chuẩn: 192.168.1.100:8080 (hệ thống tự thêm http://)
#   - Có dấu '/' ở cuối hoặc không: hệ thống tự động chuẩn hóa loại bỏ trailing slash
#   - Có sub-path nếu nằm sau proxy: http://cms.mydomain.vn/api
BASE_URL_API=http://<IP_HOAC_DOMAIN_CMS>:8080

# Khóa phiên (Session key / Token) xác thực với CMS Backend API
# Nhập session key hoặc API token được cấp bởi CMS
SESSION_KEY=<YOUR_CMS_SESSION_KEY>

# Loại dịch vụ camera nhận diện (phân cách bằng dấu phẩy)
# Hệ thống sẽ chỉ xử lý các camera trên CMS có trường service_type khớp giá trị này
SERVICE_TYPES=people_counting,people_couting

# Loại metric khi gửi kết quả đếm lên CMS (POST /api/camera-statistics)
# Mặc định: people_counting
METRIC_TYPE=people_counting

# ==============================================================================
# CẤU HÌNH GỬI THỐNG KÊ (STATISTICS)
# ==============================================================================
# Chu kỳ gửi số liệu thống kê (enter, exit, count) lên CMS (tính bằng giây)
STATISTICS_POST_INTERVAL=5

# Chu kỳ in log thống kê chi tiết ra màn hình console (giây)
STATS_LOG_INTERVAL=60

# ==============================================================================
# CẤU HÌNH THÔNG BÁO TELEGRAM (TUỲ CHỌN)
# ==============================================================================
# Nếu muốn nhận thông báo hoặc hình ảnh qua Telegram bot:
# Ví dụ: TELEGRAM_BASE_URL=https://api.telegram.org/bot<YOUR_BOT_TOKEN>
TELEGRAM_BASE_URL=
TELE_CHAT_ID=

# ==============================================================================
# CẤU HÌNH DETECTOR (YOLOv8 Person Detection qua gRPC)
# ==============================================================================
# Địa chỉ gRPC kết nối tới detector service
# Khi chạy qua docker-compose độc lập: grpc_person_detector:50060 hoặc localhost:50061
YOLO_PERSON_ADDR=grpc_person_detector:50060

# Ngưỡng tin cậy phát hiện người (0.0 -> 1.0)
CONFIDENT_PERSON=0.35

# ==============================================================================
# CẤU HÌNH CAMERA & GIẢI MÃ VIDEO (DECODING)
# ==============================================================================
# ID của card GPU NVIDIA dùng để xử lý (0, 1, ...)
GPU_ID=0

# Bắt buộc decode bằng CPU thay vì GPU NVDEC (True/False)
FORCE_CPU_DECODE=False

# Bật/tắt bộ lọc phát hiện chuyển động trước khi gửi qua YOLO (True/False)
USE_MOTION_DETECTOR=False

# Tần số xử lý (FPS) cho mỗi camera
TARGET_FPS=25
DETECT_FPS=10
SKIP_FRAME=3

# ByteTrack + hysteresis line counting
USE_BYTETRACK=True
TRACK_HIGH_THRESH=0.50
TRACK_LOW_THRESH=0.10
NEW_TRACK_THRESH=0.60
TRACK_BUFFER=75
MATCH_THRESH=0.80
LINE_BUFFER_PIXELS=35.0
STATIONARY_DISPLACEMENT_MAX=20.0
STATIONARY_FRAMES=15
COUNT_COOLDOWN_SECONDS=3.0
ENABLE_TRACK_STITCHER=True

# ==============================================================================
# CẤU HÌNH BÁM VẾT (TRACKING) & ĐIỀU KIỆN ĐẾM
# ==============================================================================
# Số frame tối thiểu track phải tồn tại trước khi được xét tính vào số đếm
MIN_FRAMES_BEFORE_COUNT=2

# Dịch chuyển tối thiểu của quỹ đạo (pixel) để chống rung camera / nhiễu
MIN_PATH_MOVEMENT_PIXELS=5.0

# Độ dài lịch sử quỹ đạo lưu trữ (frames)
PATH_HISTORY_LEN=12

# ==============================================================================
# THƯ MỤC LƯU TRỮ VÀ DOCKER IMAGES
# ==============================================================================
# Thư mục lưu log trên máy host
LOG_DIR=/mnt/logs/people_counting

# Tên Docker Image (có thể đổi theo registry nội bộ)
IMAGE_NAME_COUNTING=harbor.tado.vn/long_dev/people_counting:v2.0.0
